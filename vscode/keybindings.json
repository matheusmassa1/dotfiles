// Place your key bindings in this file to override the defaults
[
  // Bind ";" here (not via vim.*) so the key is consumed as a shortcut.
  // A vim remap races ";" into whichkey's QuickPick → "; is undefined" → menu closes,
  // which feels like you need to press ";" twice.
  {
    "key": ";",
    "command": "whichkey.show",
    "when": "editorTextFocus && vim.active && !whichkeyVisible && (vim.mode == 'Normal' || vim.mode == 'Visual' || vim.mode == 'VisualBlock' || vim.mode == 'VisualLine')"
  },
  {
    "key": "tab",
    "command": "workbench.action.nextEditor",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  {
    "key": "shift+tab",
    "command": "workbench.action.previousEditor",
    "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
  },
  // Fix: Calva/Paredit steals Backspace during Vim / and : input,
  // which deletes file text instead of the search/command string.
  {
    "key": "backspace",
    "command": "-paredit.deleteBackward"
  },
  {
    "key": "backspace",
    "command": "paredit.deleteBackward",
    "when": "calva:keybindingsEnabled && editorTextFocus && !calva:cursorInComment && !editorHasMultipleSelections && !editorReadOnly && editorLangId == 'clojure' && paredit:keyMap == 'strict' && vim.mode == 'Insert'"
  },
  {
    "key": "backspace",
    "command": "extension.vim_backspace",
    "when": "editorTextFocus && vim.active && !inDebugRepl && (vim.mode == 'SearchInProgressMode' || vim.mode == 'CommandlineInProgress')"
  }
]
